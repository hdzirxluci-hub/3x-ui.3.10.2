# Rendered by /opt/entrypoint.sh — placeholders are @@NAME@@.
#
# Why this file exists at all: Railway routes exactly one public port per
# service and terminates TLS at its own edge. The panel wants 2053, the
# subscription server wants 2096 and the Xray inbound wants its own port, so
# all three are put on loopback and split here by URL path.
#
# Important: 3x-ui serves the panel at "<webBasePath><webBasePath>..." — with a
# webBasePath of /panel/ the real API lives at /panel/panel/api/. The panel
# therefore needs the URI forwarded UNCHANGED. Do not add a trailing slash to
# proxy_pass for the panel location: that would strip the prefix and the SPA's
# absolute asset URLs (/panel/assets/...) would 404.

worker_processes 1;
error_log /dev/stderr warn;
pid /run/nginx/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    # Railway's edge terminates TLS and talks plain HTTP to us.
    access_log /dev/stdout;
    sendfile on;
    tcp_nopush on;
    keepalive_timeout 65;

    # WebSocket tunnels are long-lived; the default 60s read timeout drops them.
    # Xray sends no application-level keepalive, so this must cover idle time.
    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    server {
        listen @@HTTP_PORT@@;
        listen [::]:@@HTTP_PORT@@;
        server_name _;

        # Railway's own health probe + a cheap liveness endpoint.
        location = /healthz {
            access_log off;
            add_header Content-Type text/plain;
            return 200 "ok\n";
        }

        # --- Panel ------------------------------------------------------------
        # URI is passed through untouched on purpose (see the note above).
        location @@PANEL_PATH@@ {
            proxy_pass http://127.0.0.1:@@PANEL_PORT@@;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;

            # --- rebrand --------------------------------------------------
            # The frontend is compiled into the x-ui binary (go:embed all:dist),
            # so there is no file on disk to patch. nginx sits in front of it,
            # so the brand is rewritten on the way through instead.
            #
            # sub_filter needs an uncompressed body, hence proxy_set_header
            # Accept-Encoding "". The CSS classes are left alone, so nothing
            # about the layout or the font changes.
            #
            # Each pattern is scoped to the brand element. A bare "3X-UI"
            # replacement would also hit strings like "🚀 3X-UI Version:" and
            # the update dialogs, which should keep naming the real project.
            proxy_set_header Accept-Encoding "";
            sub_filter_once off;
            # text/html is always filtered by default; listing it again makes
            # nginx warn about a duplicate MIME type.
            sub_filter_types application/javascript text/javascript;
            # login page brand
            sub_filter 'brand-name`,children:`3X-UI`'   'brand-name`,children:`@@BRAND@@`';
            # sidebar brand (expanded and collapsed forms)
            sub_filter 'children:E?`3X`:`3X-UI`'        'children:E?`@@BRAND@@`:`@@BRAND@@`';
            # mobile drawer brand
            sub_filter 'drawer-brand`,children:`3X-UI`' 'drawer-brand`,children:`@@BRAND@@`';
            # browser tab title
            sub_filter '<title>Sign in</title>'          '<title>@@BRAND@@</title>';
        }

        # --- Subscription -----------------------------------------------------
        # The sub server serves the panel's generated subPath on @@SUB_PORT@@.
        # A stable public path (/sub/) is exposed and rewritten onto it, so the
        # link you put in v2rayNG never changes when the panel rotates it.

        # /sub is the human-readable page, rendered by the Python sidecar. It
        # decodes the base64 server side, so what a browser shows is exactly
        # what curl gets -- a static JS page could not be verified that way and
        # shipped blank once.
        location = @@SUB_PATH_NOSLASH@@ {
            proxy_pass http://127.0.0.1:@@SUBPAGE_PORT@@;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto https;
        }

        location @@SUB_PATH@@ {
            # Bare /sub/ -> the viewer.
            rewrite ^@@SUB_PATH@@$ @@SUB_PATH_NOSLASH@@ last;
            # Drop a trailing slash. Chrome appends one on its own, so
            # /sub/mobile/ has to resolve exactly like /sub/mobile.
            rewrite ^@@SUB_PATH@@(.+?)/+$ @@SUB_PATH@@$1 last;

            # A thin forwarder in front of 3x-ui's own sub server. The page a
            # browser gets is 3x-ui's built-in subpage.html; the forwarder only
            # exists to apply one policy -- it drops the Subscription-Userinfo
            # header when the client has no quota, because 3x-ui always emits
            # total=0/expire=0 and apps such as v2box divide by total, fail and
            # report an error even though the configs arrived fine.
            proxy_pass http://127.0.0.1:@@SUBPAGE_PORT@@;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }

        # The built-in sub page is a Vite/React bundle and asks for its CSS and
        # JS at /<subPath>/assets/... -- its own random path, not under /sub/.
        # Without this rule every one of those requests falls into "location /"
        # and 404s, and the page renders as an empty white screen.
        location @@SUB_REAL_PATH@@ {
            proxy_pass http://127.0.0.1:@@SUB_PORT@@;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }

        # --- VLESS + WebSocket inbound ---------------------------------------
        # Xray listens on loopback here; Railway's edge already did the TLS.
        location @@TUNNEL_PATH@@ {
            proxy_pass http://127.0.0.1:@@INBOUND_PORT@@;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            # Tunnel traffic is idle most of the time; do not reap it.
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
            proxy_buffering off;
        }

        # Anything else is not ours to answer. Returning 404 (rather than
        # proxying to Xray) keeps scanners off the inbound.
        location / {
            return 404;
        }
    }
}
